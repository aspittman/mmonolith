# Collector switches
COLLECT_UPWORK=true
COLLECT_REDDIT=true
COLLECT_GOOGLE_TRENDS=false

# Upwork is import-only. Put an authorized export at this path.
UPWORK_CSV_PATH=data/raw/upwork.csv

# Public Reddit RSS configuration (comma-separated search phrases)
REDDIT_QUERIES="need a developer","website help","API integration","website broken","automation help"
REDDIT_LIMIT_PER_QUERY=25
REDDIT_USER_AGENT=demand-seeker/1.0 market-research

# Optional Google Trends settings
GOOGLE_TRENDS_GEO=US
GOOGLE_TRENDS_KEYWORDS=API integration,AI chatbot,website speed optimization,WordPress fix,Stripe integration

# Analysis tuning
DAYS_SHORT=7
DAYS_LONG=30
MIN_OBSERVATIONS_FOR_HIGH_CONFIDENCE=50
DEMAND_WEIGHT_VOLUME=0.30
DEMAND_WEIGHT_GROWTH=0.20
DEMAND_WEIGHT_BUDGET=0.20
DEMAND_WEIGHT_RECENCY=0.15
DEMAND_WEIGHT_SOURCE_DIVERSITY=0.15

# CRM: disabled runs never contact the CRM
CRM_SYNC_ENABLED=false
CRM_BASE_URL=
BOT_API_SECRET=
CRM_MARKET_DEMAND_ENDPOINT=/api/bot/market-demand

LOG_LEVEL=INFO

# Independent Google Play service (fixture/import provider requires no credentials)
GOOGLE_PLAY_ENABLED=false
GOOGLE_PLAY_COUNTRIES=US
GOOGLE_PLAY_CATEGORIES=
GOOGLE_PLAY_FIXTURE_PATH=data/raw/google_play.example.json
GOOGLE_PLAY_OUTPUT_DIR=data/processed/google_play
GOOGLE_PLAY_MIN_RATING_COUNT=50
GOOGLE_PLAY_MIN_INSTALL_ESTIMATE=1000
GOOGLE_PLAY_MAX_COMPETITION=80
GOOGLE_PLAY_MAX_BUILD_COMPLEXITY=70
GOOGLE_PLAY_MIN_CONFIDENCE=35
GOOGLE_PLAY_MIN_SCORE=45
GOOGLE_PLAY_MAX_RESULTS=10
GOOGLE_PLAY_REVIEW_SAMPLE_SIZE=200
GOOGLE_PLAY_HISTORICAL_TRACKING=true

# Attention-velocity trends service. Explicit --trends runs regardless of TRENDS_ENABLED;
# TRENDS_ENABLED is reserved for an external scheduler/systemd/cron integration.
TRENDS_ENABLED=false
TRENDS_WATCH_MODE_ENABLED=true
TRENDS_DISCOVERY_MODE_ENABLED=true
TRENDS_COUNTRIES=US
TRENDS_REGIONS=
TRENDS_CATEGORIES=
TRENDS_WATCH_TOPICS=microgreens,domain investing,website optimization,AI receptionist,contractor software,mobile detailing software,Google Play development
TRENDS_SHORT_WINDOW=30
TRENDS_MEDIUM_WINDOW=180
TRENDS_LONG_WINDOW=1825
TRENDS_MIN_ATTENTION_SCORE=35
TRENDS_MIN_COMMERCIAL_SCORE=40
TRENDS_MIN_CONFIDENCE=25
TRENDS_MAX_EVENT_SPIKE=85
TRENDS_MAX_DISCOVERY_TOPICS=50
TRENDS_MAX_RELATED_QUERIES=20
TRENDS_MAX_EXPANSION_DEPTH=2
TRENDS_MAX_CHILDREN=8
TRENDS_MIN_CHILD_SIGNAL=30
TRENDS_ROUTE_TO_SERVICES=true
TRENDS_ROUTE_SCORE=70
TRENDS_ROUTE_CONFIDENCE=55
TRENDS_HISTORICAL_TRACKING=true
TRENDS_CACHE_TTL_HOURS=24
TRENDS_PROVIDER_TIMEOUT=20
TRENDS_PROVIDER_RETRIES=2
TRENDS_FIXTURE_PATH=data/raw/trends.example.json
TRENDS_OUTPUT_DIR=data/processed/trends
