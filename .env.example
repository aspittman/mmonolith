# Collector switches
COLLECT_UPWORK=true
COLLECT_REDDIT=true
COLLECT_GOOGLE_TRENDS=false

# Upwork is import-only. Put an authorized export at this path.
UPWORK_CSV_PATH=data/raw/upwork.csv

# Public Reddit RSS configuration (comma-separated search phrases)
REDDIT_QUERIES="need a developer","website help","API integration","website broken","automation help"
REDDIT_LIMIT_PER_QUERY=25
REDDIT_USER_AGENT=demand-seeker/1.0 market-research

# Optional Google Trends settings
GOOGLE_TRENDS_GEO=US
GOOGLE_TRENDS_KEYWORDS=API integration,AI chatbot,website speed optimization,WordPress fix,Stripe integration

# Analysis tuning
DAYS_SHORT=7
DAYS_LONG=30
MIN_OBSERVATIONS_FOR_HIGH_CONFIDENCE=50
DEMAND_WEIGHT_VOLUME=0.30
DEMAND_WEIGHT_GROWTH=0.20
DEMAND_WEIGHT_BUDGET=0.20
DEMAND_WEIGHT_RECENCY=0.15
DEMAND_WEIGHT_SOURCE_DIVERSITY=0.15

# CRM: disabled runs never contact the CRM
CRM_SYNC_ENABLED=false
CRM_BASE_URL=
BOT_API_SECRET=
CRM_MARKET_DEMAND_ENDPOINT=/api/bot/market-demand

LOG_LEVEL=INFO

